# Mahliyo AI server environment.
# Copy this file to .env and set a valid key from Google AI Studio.
PORT=5000

# Flask session signing key (generate a unique value with: python3 -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=replace-with-a-random-secret

# Google Gemini API key (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# OpenRouter API key for ordinary text chat (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
