# Mahliyo AI server environment.
# Copy this file to .env and set an OpenRouter key.
PORT=5000
DAILY_AI_LIMIT=10000

# Flask session signing key (generate a unique value with: python3 -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=replace-with-a-random-secret

# Mahliyo API access key (generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))")
MAHLIYO_API_KEY=replace-with-a-random-api-key

# OpenRouter API key for chat, search, translation, images, and video
# Create one at https://openrouter.ai/keys; keep it server-side.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_VISION_MODEL=openrouter/free
OPENROUTER_IMAGE_MODEL=google/gemini-3.1-flash-image
OPENROUTER_VIDEO_MODEL=google/veo-3.1-lite

# All model requests go through OpenRouter.
CHAT_PROVIDER=openrouter
